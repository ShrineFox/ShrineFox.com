@using System.Net
@using System.Text.RegularExpressions
@using ShrineFoxCom.Components.Elements.Spectre_Framework


@using (var client = new HttpClient())
{
    bool streaming = false;
    string details = "";
    bool showDetails = true;
    string streamEmbedTxtPath = Path.Combine(Environment.CurrentDirectory, "useStreamEmbed.txt") ?? "";
    string twitchTxtPath = Path.Combine(Environment.CurrentDirectory, "useTwitchText.txt") ?? "";
    string fallbackTwitchTxtPath = Path.Combine(Environment.CurrentDirectory, "fallbackTwitchText.txt") ?? "";

    if (File.Exists(streamEmbedTxtPath))
        streaming = true; // show streaming embed on home page
        
    if (File.Exists(twitchTxtPath))
    {
        // Set details by downloading data from Twitch page
        var response = client.GetAsync("https://twitch.tv/shrinefox", HttpCompletionOption.ResponseHeadersRead).GetAwaiter().GetResult();
        response.EnsureSuccessStatusCode();
        string html = response.Content.ReadAsStringAsync().GetAwaiter().GetResult();
        if (html.Contains("Streaming")) // Should only contain "streaming" if live
        {
            Match match = Regex.Match(html, @"<meta\s+property=[""']og:description[""']\s+content=[""']([^""']*)[""']", RegexOptions.IgnoreCase);
            if (match.Success)
            {
                details = @match.Groups[1].Value ?? "";
            }
        }
        else
        {
            // hide details above streaming embed
            showDetails = false; 
        }
    }
    else if (File.Exists(fallbackTwitchTxtPath))
    {
        // Use fallback text instead for details
        details = File.ReadAllText(fallbackTwitchTxtPath) ?? "";
    }
    else
    {
        // hide details above streaming embed
        showDetails = false;
    }

    if (streaming)
    {
        if (showDetails)
        {
            <Card>
                <h1>
                    🔴 ShrineFox is <a href="https://twitch.tv/ShrineFox">
                    Live on <i class="fa-brands fa-twitch"></i> Twitch
                </a>
                </h1>
                <h3>
                    @details
                </h3>
            </Card>
        }
        else
        {
            <center><h2>Latest Livestream</h2></center>
        }


        <div class="responsive-embed">
        <iframe src="https://player.twitch.tv/?channel=shrinefox&amp;parent=shrinefox.com&amp;autoplay=true&amp;muted=false"
                    class="twitch-player"
                    title="Twitch player"
                    loading="lazy"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allow="autoplay; fullscreen; picture-in-picture"
                    allowfullscreen>
            </iframe>
            <iframe class="twitch-chat"
                src="https://www.twitch.tv/embed/shrinefox/chat?parent=shrinefox.com"
                    title="Twitch Chat"
                    loading="lazy">
            </iframe>
        </div>
    
    }
}



<style>
    .responsive-embed {
        width: 100%;
    }

        .responsive-embed iframe {
            width: 100%;
            height: 500px;
            border: 0;
        }

    .twitch-player
    {
        width: 70% !important;
    }

    .twitch-chat {
        width: 29% !important;
    }

    @@media only screen and (max-width: 900px) {
        .twitch-player {
            width: 100% !important;
        }

        .twitch-chat {
            width: 100% !important;
        }
    }
</style>