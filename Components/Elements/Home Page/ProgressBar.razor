@code
{
    [Parameter]
    public string Percentage { get; set; }
    [Parameter]
    public string Color { get; set; } = "rgba(var(--accent), 1);";
}

<div class="flex-centered">
    <div class="container" style="border-radius: 30px;">
        <div class="progress2 progress-moved2">
            <div class="progress-bar2" style="
            width: @Percentage;
            background-color: @Color;
            "></div>
        </div>
    </div>
</div>
