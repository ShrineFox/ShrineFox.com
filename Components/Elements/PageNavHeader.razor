@inject IJSRuntime JS

@code
{
    [Parameter]
    public string CurrentPageName { get; set; } = "";
}

@if (!string.IsNullOrEmpty(CurrentPageName))
{
	<div class="navipath">
		<a href="/"><i class="fa fa-home" aria-hidden="true"></i> ShrineFox.com</a>
		<i class="fa fa-angle-right" aria-hidden="true"></i> @CurrentPageName
	</div>

    <Notice Icon="fa-triangle-exclamation">
        Due to <a href="https://cybersecuritynews.com/php-to-issue-emergency-patch/">critical PHP vulernabilities</a>, parts of the site utilizing phpbb and wordpress will be temporarily offline.
        <br>This affects the forum, blog, and wiki. Wherever possible, the Wayback Machine will serve cached content instead.
        <br>Thank you for understanding. Typical browsing will be reinstated soon.
    </Notice>
}
