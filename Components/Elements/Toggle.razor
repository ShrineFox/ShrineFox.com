@inject IJSRuntime JS

@code
{
    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public string Class { get; set; } = "";

    [Parameter]
    public string ID { get; set; } = "accordion-1";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

<div class="accordion">
    <input type="checkbox" id="@ID" name="accordion-checkbox" hidden>
    <label class="accordion-header" for="@ID" style="cursor: pointer;">
        <div class="@Class">@Title <i class="fa-solid fa-chevron-down"></i></div>
    </label>
    <div class="accordion-body">
        @ChildContent
    </div>
</div>