					 ImgUrl="/images/projects/Vinesauce/toggles/p5v-7-1-bgm.webp"
				 Subtitle="Delete existing music replacements and re-generate from DefaultMusic.json at startup.. (Default: false)
		<br>When this option is enabled, each time the game is started with the mod loaded, all BGM from the <code>
		p5rpc.vinesauce\Music</code> folder will be copied to destinations specified by <code>p5rpc.vinesauce\DefaultMusic.json</code>.
		<br>This option should only be used when you have changed DefaultMusic.json by 
adding/removing/re-assigning BGM track destinations using P5VMusicTool. The purpose of 
P5VMusicTool is to keep all duplicates of .adx files (used for different randomized sets of 
music) identical, for easier updating and to keep the mod size down when compressed-- which will 
be handy for release. This option may be removed before a proper release.
		<br>When this option is disabled, this mod will not change values in the UserConfig.json 
files of other mods such as P5RCBT. This is done for purposes such as setting the accent colors of 
party members to match the Vinesauce mod, or setting the protagonist's name to Vinny Vinesauce using 
the force protag name mod.">
private void CreatePMEFiles()
{
    var modDir = _modLoader.GetDirectoryForModId(_modConfig.ModId);
    string jsonPath = Path.GetFullPath(Path.Combine(modDir, ".//DefaultMusic.json"));

    if (File.Exists(jsonPath))
    {
        _logger.WriteLine($"Creating PME Files for Battle BGM...", Color.Tan);

        string json = File.ReadAllText(jsonPath);
        Project currentProject = JsonConvert.DeserializeObject&#x3C;Project>
(json);

        List&#x3C;string>
 costumeNames = currentProject.Destinations
            .Where(x =>
 x.CueID >
 -1)
            .Select(x =>
 x.CostumeName)
            .Distinct()
            .ToList();

        foreach (var costume in costumeNames)
        {
            string pmePath = $"{modDir}\\Costumes\\Joker\\{costume}\\music.pme";

            if (File.Exists(pmePath) &#x26;&#x26; !_configuration.ForceCopyCustomBGM)
                continue;

            var normalBattleIDs = string.Join(",", currentProject.Destinations
                .Where(x =>
 x.CueID >
 -1 &#x26;&#x26; x.CostumeName == costume &#x26;&#x26; x.NormalBattle)
                .Select(x =>
 x.CueID.ToString())
                .ToList());
...
