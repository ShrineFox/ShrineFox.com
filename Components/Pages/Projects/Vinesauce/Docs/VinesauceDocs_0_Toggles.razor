private void UpdateChatPingSFX(string modDir, bool usePingSFX)
{
    string awbEmuDir01 = Path.Combine(modDir, "FEmulator\\AWB\\SPT01.AWB");
    string awbEmuDir02 = Path.Combine(modDir, "FEmulator\\AWB\\SPT02.AWB");
